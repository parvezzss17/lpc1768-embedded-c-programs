//project 6:
//merging leds from 19 and 26

#include <lpc17xx.h>

int main()
{
    LPC_GPIO1->FIODIR = (0xff << 19);

    while(1)
    {
        int i;

        LPC_GPIO1->FIOCLR = (0xff << 19);
        LPC_GPIO1->FIOSET = (1 << 26) | (1 << 19);
        for(i = 0; i < 500000; i++);

        LPC_GPIO1->FIOCLR = (0xff << 19);
        LPC_GPIO1->FIOSET = (1 << 25) | (1 << 20);
        for(i = 0; i < 500000; i++);

        LPC_GPIO1->FIOCLR = (0xff << 19);
        LPC_GPIO1->FIOSET = (1 << 24) | (1 << 21);
        for(i = 0; i < 500000; i++);
 
        LPC_GPIO1->FIOCLR = (0xff << 19);
        LPC_GPIO1->FIOSET = (1 << 23) | (1 << 22);
        for(i = 0; i < 500000; i++);
    }
}
